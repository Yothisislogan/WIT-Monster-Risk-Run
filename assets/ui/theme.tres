[gd_resource type="Theme" load_steps=8 format=3 uid="uid://witheme000001"]

; Project-wide UI theme (GAME_DESIGN.md §23, §22).
;
; There was no theme at all before this: every label set its own font size ad
; hoc, from 13px to 54px, with no outline and several at 40-78% opacity. On a
; phone, over a scrolling parallax background, that is unreadable — and the
; smallest offenders were the Risk readout (13px) and the ability readout
; (14px at 40% alpha), both of which sit directly on the playfield.
;
; The outline is the single biggest win. Light text on a busy background needs
; a dark edge to separate it; without one the glyphs dissolve into whatever is
; scrolling behind them. Everything here inherits it, including any text added
; later, which is the other reason a theme beats per-node overrides.
;
; THE STYLEBOXES BELOW ARE NOT DECORATION. The first version of this file set
; colours and font sizes and nothing else, and a project theme registered as
; gui/theme/custom REPLACES the styling the engine would otherwise supply. So
; PanelContainer had no panel background and Button had no normal, hover or
; pressed background: the Policy Card draft rendered as its title floating over
; the playfield with a single focus outline where four opaque cards should have
; been, and the player reported it, correctly, as an empty screen. A theme that
; styles type and not surfaces is worse than no theme at all — it removes the
; surfaces that were there.

; The card the panels are drawn on. Opaque, because a modal that shows the
; playfield through it is a modal you cannot read.
[sub_resource type="StyleBoxFlat" id="panel"]
content_margin_left = 18.0
content_margin_top = 16.0
content_margin_right = 18.0
content_margin_bottom = 16.0
bg_color = Color(0.06, 0.07, 0.12, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.32, 0.42, 0.62, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 12

